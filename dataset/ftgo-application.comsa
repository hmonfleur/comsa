amends "modulepath:/comsa.pkl"
version = "3"
local BusinessServices = Set(
  "ftgo-consumer-service",
  "ftgo-order-service",
  "ftgo-kitchen-service",
  "ftgo-restaurant-service",
  "ftgo-accounting-service",
  "ftgo-delivery-service",
  "ftgo-order-history-service"
)
concerns {
  ["FTGO Images"]
    = new ImageConcern {
        sids = BusinessServices + Set("ftgo-api-gateway", "mysql", "dynamodblocal", "dynamodblocal-init")
//        image = "msapatterns/{SID}" // missing ftgo-delivery-service
        image = "odidev/ftgo-application_{SID}" // seems ok
      }

  ["Build"]
    = new BuildConcern {
        sids = BusinessServices + Set("ftgo-api-gateway", "mysql")
        build = (sid) ->
          new BuildAlternate1 {
            context = "./\(sid)" // CSPTC
          }
        services {
          [BusinessServices + Set("ftgo-api-gateway")] {
            build {
              args { // CSPTC
                ["baseImageVersion"] = "${EVENTUATE_JAVA_BASE_IMAGE_VERSION}"
              }
            }
          }
          ["mysql"] {
            build {
              args { // CSPTC
                ["EVENTUATE_COMMON_VERSION"] = "${EVENTUATE_COMMON_VERSION?}"
                ["EVENTUATE_SAGA_VERSION"] = "${EVENTUATE_SAGA_VERSION?}"
              }
            }
          }
          [Set("dynamodblocal", "dynamodblocal-init")] {
            build = "./{SID}" // CSPTC
          }
        }
      }

  ["Environment"]
    = new EnvironmentConcern {
        sids = Set(
          "ftgo-consumer-service",
          "ftgo-order-service",
          "ftgo-kitchen-service",
          "ftgo-restaurant-service",
          "ftgo-accounting-service",
          "ftgo-delivery-service"
        )
        environment = (sid) ->
          let(tmp = sid.replaceAll("-", "_"))
            new Mapping {
              ["SPRING_DATASOURCE_URL"] = "jdbc:mysql://mysql/\(tmp)" // CSPTC
              ["SPRING_DATASOURCE_USERNAME"] = "\(tmp)_user" // CSPTC
              ["SPRING_DATASOURCE_PASSWORD"] = "\(tmp)_password" // CSPTC
              ["SPRING_DATASOURCE_DRIVER_CLASS_NAME"] = "com.mysql.jdbc.Driver" // CSPTC
              ["EVENTUATE_DATABASE_SCHEMA"] = tmp // CSPTC
            }
      }

  ["Public Ports"]
    = new PublicPortsConcern {
        ports {
          ["zookeeper"] { "2181:2181" } // CSPTC
          ["mysql"] { "3306:3306" } // CSPTC
          ["kafka"] { "9092:9092" } // CSPTC
          ["cdc-service"] { "8099:8080" } // CSPTC
          ["ftgo-consumer-service"] { "8081:8080" } // CSPTC
          ["ftgo-order-service"] { "8082:8080" } // CSPTC
          ["ftgo-kitchen-service"] { "8083:8080" } // CSPTC
          ["ftgo-restaurant-service"] { "8084:8080" } // CSPTC
          ["ftgo-accounting-service"] { "8085:8080" } // CSPTC
          ["ftgo-order-history-service"] { "8086:8080" } // CSPTC
          ["ftgo-api-gateway"] { "8087:8080" } // CSPTC
          ["zipkin"] { "9411:9411" } // CSPTC
          ["dynamodblocal"] { "8000:8000" } // CSPTC
          ["kafka-gui"] { "9088:8080" } // CSPTC
        }
      }

  ["Zookeeper"]
    = new ServiceRegistryPattern {
        msid = "zookeeper"
        main_service_template {
          image = "eventuateio/eventuate-zookeeper:0.15.0.RELEASE" // CSPTC
          environment {
            ["ZOOKEEPER_CLIENT_PORT"] = 2181 // CSPTC
            ["KAFKA_HEAP_OPTS"] = "-Xmx64m" // CSPTC // TODO: why is needed?
          }
        }
        sids = BusinessServices + Set("kafka", "cdc-service")
        services {
          ["kafka"] {
            environment {
              ["KAFKA_ZOOKEEPER_CONNECT"] = "zookeeper:2181" // CSPTC
            }
          }
          [BusinessServices + Set("cdc-service")] {
            environment {
              ["EVENTUATELOCAL_ZOOKEEPER_CONNECTION_STRING"] = "zookeeper:2181" // CSPTC
            }
          }
        }
      }

  ["Kafka"]
    = new MessagingPattern {
        msid = "kafka"
        main_service_template {
          image = "eventuateio/eventuate-kafka:0.15.0.RELEASE" // CSPTC
          environment {
            ["KAFKA_LISTENERS"] = "LC://kafka:29092,LX://kafka:9092" // CSPTC
            ["KAFKA_ADVERTISED_LISTENERS"] = "LC://kafka:29092,LX://localhost:9092" // CSPTC
            ["KAFKA_LISTENER_SECURITY_PROTOCOL_MAP"] = "LC:PLAINTEXT,LX:PLAINTEXT" // CSPTC
            ["KAFKA_INTER_BROKER_LISTENER_NAME"] = "LC" // CSPTC
            ["KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR"] = 1 // CSPTC
            ["KAFKA_HEAP_OPTS"] = "-Xmx192m" // CSPTC
          }
          expose {
            "29092" // for Kubernetes
          }
        }
        sids = BusinessServices + Set("cdc-service", "kafka-gui")
        services {
          [BusinessServices + Set("cdc-service")] {
            environment {
              ["EVENTUATELOCAL_KAFKA_BOOTSTRAP_SERVERS"] = "kafka:29092" // CSPTC
            }
          }
          ["kafka-gui"] {
            image = "quay.io/cloudhut/kowl:master-1d07695" // CSPTC
            environment {
              ["KAFKA_BROKERS"] = "kafka:29092" // CSPTC
            }
          }
        }
      }

  ["MySql"]
    = new SharedDatabasePattern {
        msid = "mysql"
        main_service_template {
          environment = new Listing {
            "MYSQL_ROOT_PASSWORD=rootpassword" // CSPTC
            "MYSQL_USER=mysqluser" // CSPTC
            "MYSQL_PASSWORD=mysqlpw" // CSPTC
          }
        }
        sids = Set(
          "cdc-service",
          "ftgo-consumer-service",
          "ftgo-order-service",
          "ftgo-kitchen-service",
          "ftgo-restaurant-service",
          "ftgo-accounting-service",
          "ftgo-delivery-service"
        )
      }

    ["Transactional Outbox"]
      = new TransactionalOutboxPattern {
          msid = "cdc-service"
          main_service_template {
            image = "eventuateio/eventuate-cdc-service:0.13.0.RELEASE" // CSPTC
            environment {
              ["EVENTUATE_CDC_PIPELINE_PIPELINE1_TYPE"] = "eventuate-tram" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE1_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE1_EVENTUATEDATABASESCHEMA"] = "ftgo_consumer_service" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE2_TYPE"] = "eventuate-tram" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE2_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE2_EVENTUATEDATABASESCHEMA"] = "ftgo_order_service" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE3_TYPE"] = "eventuate-tram" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE3_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE3_EVENTUATEDATABASESCHEMA"] = "ftgo_kitchen_service" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE4_TYPE"] = "eventuate-tram" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE4_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE4_EVENTUATEDATABASESCHEMA"] = "ftgo_restaurant_service" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE5_TYPE"] = "eventuate-tram" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE5_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE5_EVENTUATEDATABASESCHEMA"] = "ftgo_accounting_service" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE6_TYPE"] = "eventuate-tram" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE6_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE6_EVENTUATEDATABASESCHEMA"] = "ftgoorderhistoryservice" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE7_TYPE"] = "eventuate-local" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE7_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE7_EVENTUATEDATABASESCHEMA"] = "ftgo_accounting_service" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE8_TYPE"] = "eventuate-tram" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE8_READER"] = "reader1" // CSPTC
              ["EVENTUATE_CDC_PIPELINE_PIPELINE8_EVENTUATEDATABASESCHEMA"] = "ftgo_delivery_service" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_TYPE"] = "mysql-binlog" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_DATASOURCEURL"] = "jdbc:mysql://mysql:3306/eventuate" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_DATASOURCEUSERNAME"] = "root" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_DATASOURCEPASSWORD"] = "rootpassword" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_DATASOURCEDRIVERCLASSNAME"] = "com.mysql.jdbc.Driver" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_LEADERSHIPLOCKPATH"] = "/eventuate/cdc/leader/common" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_CDCDBUSERNAME"] = "root" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_CDCDBPASSWORD"] = "rootpassword" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_READOLDDEBEZIUMDBOFFSETSTORAGETOPIC"] = "false" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_MYSQLBINLOGCLIENTUNIQUEID"] = 1 // CSPTC
              ["EVENTUATE_CDC_READER_READER1_OFFSETSTOREKEY"] = "MySqlBinlog" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_OFFSETSTORAGETOPICNAME"] = "db.history.common" // CSPTC
              ["EVENTUATE_CDC_READER_READER1_OUTBOXID"] = 1 // CSPTC
            }
          }
          sids = BusinessServices
        }

  ["Zipkin"]
    = new DistributedTracingPattern {
        msid = "zipkin"
        main_service_template {
          image = "openzipkin/zipkin:2.21" // CSPTC
          environment {
            ["JAVA_OPTS"] = "-Xmx128m" // CSPTC
          }
        }
        sids = Set("ftgo-order-service", "ftgo-delivery-service", "ftgo-api-gateway")
        service_template {
          environment {
            ["SPRING_SLEUTH_ENABLED"] = "true" // CSPTC
            ["SPRING_SLEUTH_SAMPLER_PROBABILITY"] = 1 // CSPTC
            ["SPRING_ZIPKIN_BASE_URL"] = "http://\(msid):9411/" // CSPTC
          }
        }
      }

  ["DynamoDB"]
    = new SharedDatabasePattern {
        msid = "dynamodblocal"
        main_service_template {
          environment {
            ["JAVA_OPTS"] = "-Xmx128m" // already CSPTC
          }
        }
        sids = Set("ftgo-order-history-service", "dynamodblocal-init")
        service_template {
          environment {
            ["AWS_ACCESS_KEY_ID"] = "id_key" // CSPTC
            ["AWS_SECRET_ACCESS_KEY"] = "access_key" // CSPTC
            ["AWS_DYNAMODB_ENDPOINT_URL"] = "http://dynamodblocal:8000" // CSPTC
            ["AWS_REGION"] = "us-west-2" // CSPTC
          }
        }
        services {
          ["ftgo-order-history-service"] {
// TODO            depends_on = module.Dependency("dynamodblocal-init", false) // CSPTC
          }
          ["dynamodblocal-init"] {
            restart = "on-failure" // CSPTC
          }
        }
      }

  ["API Gateway"]
    = new ApiGatewayPattern {
        msid = "ftgo-api-gateway"
        main_service_template {
          environment {
            ["ORDER_DESTINATIONS_ORDERSERVICEURL"] = "http://ftgo-order-service:8080" // CSPTC
            ["ORDER_DESTINATIONS_ORDERHISTORYSERVICEURL"] = "http://ftgo-order-history-service:8080" // CSPTC
            ["CONSUMER_DESTINATIONS_CONSUMERSERVICEURL"] = "http://ftgo-consumer-service:8080" // CSPTC
          }
        }
        sids = Set("ftgo-order-service", "ftgo-order-history-service", "ftgo-consumer-service")
      }
}
