// ======================================================================
// Medium level Train Ticket configuration describing how the high level
// configuration is transformed into microservice architecture patterns.
// ======================================================================

local TsMap = TsServices.toMap()

local TsIds = TsMap.mapKeys((k, v) -> "ts-\(k)-\(v.type)").keys

local MongoIds =
    TsMap.filter((k,v) -> v.with_mongo).keys.map((k) -> "ts-\(k)-mongo")
//    Set("ts-account-mongo") // this is a dead service!

local MySqlIds =
      TsMap.filter((k,v) -> v.with_mysql).keys.map((k) -> "ts-\(k)-mysql")

local InfrastructureServices =
      Map("rabbitmq", new Listing {
        "5672:5672" // commenté dans le fichier .yml
        "15672:15672" // commenté dans le fichier .yml
      })
//          "redis", "6379:6379" // this is a dead service! // CSPTC

version = "3"
services {
// COMMENTED as redis is a dead service, seems useless, not used by any other microservices!
//  ["redis"] {
//    image = "redis" // CSPTC
//  }
}
concerns {
  ["Build"]
    = new BuildConcern {
        sids = TsIds
        build = "{SID}" // CSPTC
      }

  ["TsImages"]
    = new ImageConcern {
        sids = TsIds
        image = "codewisdom/{SID}:0.2.0" // CSPTC
      }

  ["MongoDB"]
    = new TemplatedClusterConcern {
        sids = MongoIds
        service_template {
          image = "mongo:3.4" // CSPTC
          expose {
            "27017" // non présent dans le fichier .yml
          }
        }
      }

  ["Hostname SID"]
    = new HostnameConcern {
        sids = ALL_SERVICES
        hostname = "{SID}" // CSPTC
      }

  ["RestartAlways"]
    = new RestartAlwaysConcern { // CSPTC
        sids = TsIds
      }

  ["Deploy"]
    = new DeployConcern {
        sids = TsMap.filter((k,v) -> v.with_deploy_policy).keys.map((k) -> "ts-\(k)-service")
        deploy {
          replicas = 1 // CSPTC
          restart_policy { // CSPTC
            condition = "on-failure"
          }
        }
      }

  ["Public Ports"]
    = new PublicPortsConcern {
        ports {
          for (k, v in InfrastructureServices) {
            [k] = v
          }
          for (k, v in TsMap) {
            ["ts-\(k)-\(v.type)"] { "\(v.public_port):\(v.public_port)" }
          }
        }
      }

  ["Shared MyNetwork"]
    = new SharedNetworkConcern {
        sids = InfrastructureServices.keys + TsIds + MongoIds + MySqlIds
        network_name = "my-network" // CSPTC
        network {
          driver = "bridge"
        }
      }

  for(id, value in TsMap) {
    when(value.with_mysql) {
      [id.split("-").map((v) -> v.capitalize()).join("")]
        = new DatabasePerServicePattern {
            msid = "ts-\(id)-mysql"
            main_service_template {
              image = "mysql:5.7" // CSPTC
              expose {
                "3306" // CSPTC
              }
              environment {
                ["MYSQL_ROOT_PASSWORD"] = "root" // CSPTC
              }
              healthcheck { // non présent dans le fichier .yml
                test { "CMD" "mysqladmin" "ping" "-uroot" "-proot" }
                interval = "30s"
                timeout = "5s"
                retries = 10
              }
            }
            sid = "ts-\(id)-\(value.type)"
            service {
              volumes {
                "/var/lib/mysql" // CSPTC
              }
            }
          }
        }
      }

  for(id, value in TsMap) {
    when(value.with_mongo) {
      [id.split("-").map((v) -> v.capitalize()).join("")]
        = new DatabasePerServicePattern {
            msid = "ts-\(id)-mongo"
            sid = "ts-\(id)-\(value.type)"
          }
    }
  }

  ["Messaging Pattern"]
    = new MessagingPattern {
        msid = "rabbitmq"
        main_service_template {
          image = "rabbitmq:management" // commenté dans le fichier .yml
        }
        sids = TsMap.filter((k,v) -> v.with_rabbitmq).keys.map((k) -> "ts-\(k)-service")
        service_template {
          environment {
            ["RABBITMQ_HOST"] = msid // non défini dans le fichier .yml
            ["RABBITMQ_PORT"] = "5672" // non défini dans le fichier .yml
          }
        }
      }

  ["API Gateway Pattern"]
      = new ApiGatewayPattern {
          msid = "ts-ui-dashboard"
          sids = TsMap.filter((k,v) -> v.type == "service").keys.map((k) -> "ts-\(k)-service")
        }
}

// ======================================================================
// Low level Train Ticket configuration, e.g., Compose and Kubernetes
// manifests are automatically generated by COMSA compilers.
// ======================================================================
