//functions
local idToCamelCase = (id:String) -> id.split("-").map( (e) -> e.capitalize() ).join("")
local id = (x:String) -> x

//Sets of services
local AllServices = BusinessServices + TechnicalServices

local BusinessServices = Set(
"home-timeline-service", "user-mention-service", "unique-id-service", "text-service", "media-service", "user-service", "url-shorten-service", "user-timeline-service", "post-storage-service", "compose-post-service", "social-graph-service"
)

local TechnicalServices = Set("jaeger-agent", "media-frontend", "nginx-thrift") + MemcachedServices + MongoDBServices + RedisServices

local MemcachedServices = Set(
"post-storage-memcached", "url-shorten-memcached", "user-memcached", "media-memcached"
)

local MongoDBServices = Set(
"social-graph-mongodb", "post-storage-mongodb", "user-timeline-mongodb", "url-shorten-mongodb", "user-mongodb", "media-mongodb"
)

local RedisServices = Set(
"user-timeline-redis", "home-timeline-redis", "social-graph-redis"
)

concerns {
  ["Nginx Thrift"]
    = new ApiGatewayPattern { // TODO: Is it really an API gateway or a Proxy?
        msid = "nginx-thrift"
        main_service_template {
          image = "yg397/openresty-thrift:xenial" // CSPTC
          volumes = new Listing {
            "./nginx-web-server/lua-scripts:/usr/local/openresty/nginx/lua-scripts" // CSPTC
            "./nginx-web-server/pages:/usr/local/openresty/nginx/pages" // CSPTC
            "./nginx-web-server/conf/nginx.conf:/usr/local/openresty/nginx/conf/nginx.conf" // CSPTC
            "./nginx-web-server/jaeger-config.json:/usr/local/openresty/nginx/jaeger-config.json" // CSPTC
            "./gen-lua:/gen-lua" // CSPTC
            "./docker/openresty-thrift/lua-thrift:/usr/local/openresty/lualib/thrift" // CSPTC
          }
        }
        sids = BusinessServices // TODO: check this
      }

  ["Media Frontend"]
    = new ApiGatewayPattern { // TODO: Is it really an API gateway or a Proxy?
        msid = "media-frontend"
        main_service_template {
          image = "yg397/media-frontend:xenial" // CSPTC
          volumes = new Listing {
            "./media-frontend/lua-scripts:/usr/local/openresty/nginx/lua-scripts" // CSPTC
            "./media-frontend/conf/nginx.conf:/usr/local/openresty/nginx/conf/nginx.conf" // CSPTC
          }
        }
        // TODO: sids = Set(...)
      }

  ["DistributedTracing"]
  = new DistributedTracingPattern {
    msid = "jaeger-agent"
    main_service_template {
      image = "jaegertracing/all-in-one:latest" // CSPTC
      environment = new Listing {"COLLECTOR_ZIPKIN_HTTP_PORT=9411"} // CSPTC
    }
    sids = BusinessServices // TODO: check that there are no other traced services.
  }

  ["OpenPorts"]
    = new PublicPortsConcern {
        ports {
          ["jaeger-agent"] { "16686:16686" } // CSPTC
          ["media-frontend"] { "8081:8080" } // CSPTC
          ["nginx-thrift"] { "8080:8080" } // CSPTC
          ["post-storage-service"] { "10002:9090" } // CSPTC
        }
  }

  ["BusinessImages"]
  = new ImageConcern {
    sids = BusinessServices
    image = "deathstarbench/social-network-microservices:latest" // CSPTC
  }

  ["MongoDBImages"]
  = new ImageConcern {
    sids = MongoDBServices
    image = "mongo:4.4.6" // CSPTC
  }

  ["Mongo Expose"]
    = new ExposeConcern {
        sids = MongoDBServices
        expose { "27017" } // not CSPTC because added for Kubernetes
      }

  ["RedisImages"]
  = new ImageConcern {
    sids = RedisServices
    image = "redis" // CSPTC
  }

  ["Redis Expose"]
    = new ExposeConcern {
        sids = RedisServices
        expose { "6379" } // not CSPTC because added for Kubernetes
      }

  ["MemcachedImages"]
  = new ImageConcern {
    sids = MemcachedServices
    image = "memcached" // CSPTC
  }

  ["Memcached Expose"]
    = new ExposeConcern {
        sids = MemcachedServices
        expose { "11211" } // not CSPTC because added for Kubernetes
      }

  ["HostnameConcern"]
  = new HostnameConcern {
    sids = AllServices.difference(Set("jaeger-agent"))
    hostname = id // CSPTC
  }

  ["RestartConcern"]
    = new RestartAlwaysConcern { // CSPTC
    sids = AllServices
  }

  ["BusinessEntrypoint"]
  = new EntrypointConcern {
    sids = BusinessServices
    entrypoint = idToCamelCase // CSPTC
  }

  // Data Pattern

  ["homeTimelineNoSQLDB"]
  = new DatabasePerServicePattern {
    sid = "home-timeline-service"
    msid = "home-timeline-redis"
  }

  ["socialGraphSQLDB"]
  = new DatabasePerServicePattern {
    sid = "social-graph-service"
    msid = "social-graph-mongodb"
  }

  ["socialGraphNoSQLDB"]
  = new DatabasePerServicePattern {
    sid = "social-graph-service"
    msid = "social-graph-redis"
  }

  ["postStorageSQLDB"]
  = new DatabasePerServicePattern {
    sid = "post-storage-service"
    msid = "post-storage-mongodb"
  }

  ["userTimelineSQLDB"]
  = new DatabasePerServicePattern {
    sid = "user-timeline-service"
    msid = "user-timeline-mongodb"
  }

  ["userTimelineNoSQLDB"]
  = new DatabasePerServicePattern {
    sid = "user-timeline-service"
    msid = "user-timeline-redis"
  }

  ["urlShortenSQLDB"]
  = new DatabasePerServicePattern {
    sid = "url-shorten-service"
    msid = "url-shorten-mongodb"
  }

  ["userSQLDB"]
  = new DatabasePerServicePattern {
    sid = "user-service"
    msid = "user-mongodb"
  }

  ["mediaSQLDB"]
  = new DatabasePerServicePattern {
    sid = "media-service"
    msid = "media-mongodb"
  }

  ["mediaMemcached"]
  = new DatabasePerServicePattern {
    sid = "media-service"
    msid = "media-memcached"
  }

  ["userMemcached"]
  = new DatabasePerServicePattern {
    sid = "user-service"
    msid = "user-memcached"
  }

  ["urlShortenMemcached"]
  = new DatabasePerServicePattern {
    sid = "url-shorten-service"
    msid = "url-shorten-memcached"
  }

  ["postStorageMemcached"]
  = new DatabasePerServicePattern {
    sid = "post-storage-service"
    msid = "post-storage-memcached"
  }

  ["businessVolume"]
  = new VolumesConcern {
    sids = BusinessServices
    value {
      "./config:/social-network-microservices/config" // CSPTC
    }
  }
}
