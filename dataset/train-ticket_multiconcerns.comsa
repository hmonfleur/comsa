// ======================================================================
// High level Train Ticket configuration with a dedicated configuration
// language, aka a map of TsServices.
// ======================================================================

local Dashboard: Id = "ts-ui-dashboard"

local BusinessIds = Set(
  "admin-basic-info", "admin-order", "admin-route", "admin-travel",
  "admin-user", "avatar", "basic", "cancel",
  "contacts", "execute", "preserve", "preserve-other",
  "route-plan", "seat", "ticketinfo", "travel-plan",
  "verification-code", "voucher"
  )
  + MongoIds
  + MySQLIds


local MongoIds = Set(
  "assurance", "auth", "config", "consign",
  "consign-price", "contacts", "food", "food-map",
  "inside-payment", "news", "notification", "order",
  "order-other", "payment", "price", "rebook",
  "route", "security", "station", "ticket-office",
  "train", "travel", "travel2", "user"
  // , "account" // Dead Service
)

local MySQLIds = Set("voucher")

local RabbitMQ: Id = "rabbitmq"

local id_to_business_id = (id) -> "ts-" + id + "-service"
local ids_to_business_ids = (ids) -> ids.map(id_to_business_id)

local BusinessServices = Set(Dashboard) + ids_to_business_ids.apply(BusinessIds)

local id_to_mongo_id = (id) -> "ts-" + id + "-mongo"
local ids_to_mongo_ids = (ids) -> ids.map(id_to_mongo_id)

local MongoServices = ids_to_mongo_ids.apply(MongoIds)

local id_to_mysql_id = (id) -> "ts-" + id + "-mysql"
local ids_to_mysql_ids = (ids) -> ids.map(id_to_mysql_id)

local MySQLServices = ids_to_mysql_ids.apply(MySQLIds)

local TechnicalServices = MongoServices + MySQLServices + Set(RabbitMQ)

version = "3"
services {
// COMMENTED as redis is a dead service, seems useless, not used by any other microservices!
//  ["redis"] {
//    image = "redis" // CSPTC
//  }
}
concerns {
  ["Build"]
    = new BuildConcern {
        sids = BusinessServices
        build = "{SID}" // CSPTC
      }

  ["TsImages"]
    = new ImageConcern {
        sids = BusinessServices
        image = "codewisdom/{SID}:0.2.0" // CSPTC
      }

  ["MongoDB"]
    = new TemplatedClusterConcern {
        sids = MongoServices
        service_template {
          image = "mongo:3.4" // CSPTC
          expose {
            "27017" // non présent dans le fichier .yml
          }
        }
      }

  ["Hostname SID"]
    = new HostnameConcern {
        sids = ALL_SERVICES
        hostname = "{SID}" // CSPTC
      }

  ["RestartAlways"]
    = new RestartAlwaysConcern { // CSPTC
        sids = BusinessServices
      }

  ["Deploy"]
    = new DeployConcern {
        sids = ids_to_business_ids.apply(Set("admin-route", "admin-travel", "admin-user"))
        deploy {
          replicas = 1 // CSPTC
          restart_policy { // CSPTC
            condition = "on-failure"
          }
        }
      }

  ["Shared MyNetwork"]
    = new SharedNetworkConcern {
        sids = TechnicalServices + BusinessServices
        network_name = "my-network" // CSPTC
        network {
          driver = "bridge"
        }
      }

  ["MySqlDatabases"]
  = new MultiDatabasePerServicePattern{
    values = MySQLIds.map( (id) -> List(id_to_mysql_id.apply(id), id_to_business_id.apply(id)))
    main_service{
      image = "mysql:5.7" // CSPTC
      expose {
        "3306" // CSPTC
      }
      environment {
        ["MYSQL_ROOT_PASSWORD"] = "root" // CSPTC
      }
      healthcheck { // non présent dans le fichier .yml
        test { "CMD" "mysqladmin" "ping" "-uroot" "-proot" }
        interval = "30s"
        timeout = "5s"
        retries = 10
      }
    }
    service {
      volumes {
        "/var/lib/mysql" // CSPTC
      }
    }
  }

  ["MongoDBDatabases"]
  = new MultiDatabasePerServicePattern{
    values = MongoIds.map( (id) -> List(id_to_mongo_id.apply(id), id_to_business_id.apply(id)))
  }

  ["Messaging Pattern"]
    = new MessagingPattern {
        msid = RabbitMQ
        main_service_template {
          image = "rabbitmq:management" // commenté dans le fichier .yml
        }
        sids = ids_to_business_ids.apply(Set( "preserve", "preserve-other", "notification", "food" ))
        service_template {
          environment {
            ["RABBITMQ_HOST"] = msid // non défini dans le fichier .yml
            ["RABBITMQ_PORT"] = "5672" // non défini dans le fichier .yml
          }
        }
      }

  ["API Gateway Pattern"]
  = new ApiGatewayPattern {
      msid = Dashboard
      sids = BusinessServices
  }

  ["PublicPorts"]
  = new PublicPortsConcern {
    ports {
      ["ts-avatar-service"] {"17001:17001"}
      ["ts-admin-user-service"] {"16115:16115"}
      ["ts-admin-travel-service"] {"16114:16114"}
      ["ts-admin-route-service"] {"16113:16113"}
      ["ts-admin-order-service"] {"16112:16112"}
      ["ts-admin-basic-info-service"] {"18767:18767"}
      ["ts-consign-price-service"] {"16110:16110"}
      ["ts-consign-service"] {"16111:16111"}
      ["ts-food-service"] {"18856:18856"}
      ["ts-route-plan-service"] {"14578:14578"}
      ["ts-food-map-service"] {"18855:18855"}
      ["ts-voucher-service"] {"16101:16101"}
      ["ts-news-service"] {"12862:12862"}
      ["ts-ticket-office-service"] {"16108:16108"}
      ["ts-travel-plan-service"] {"14322:14322"}
      ["ts-seat-service"] {"18898:18898"}
      ["ts-assurance-service"] {"18888:18888"}
      ["ts-cancel-service"] {"18885:18885"}
      ["ts-rebook-service"] {"18886:18886"}
      ["ts-payment-service"] {"19001:19001"}
      ["ts-execute-service"] {"12386:12386"}
      ["ts-inside-payment-service"] {"18673:18673"}
      ["ts-security-service"] {"11188:11188"}
      ["ts-notification-service"] {"17853:17853"}
      ["ts-price-service"] {"16579:16579"}
      ["ts-ticketinfo-service"] {"15681:15681"}
      ["ts-basic-service"] {"15680:15680"}
      ["ts-preserve-other-service"] {"14569:14569"}
      ["ts-preserve-service"] {"14568:14568"}
      ["ts-travel2-service"] {"16346:16346"}
      ["ts-travel-service"] {"12346:12346"}
      ["ts-train-service"] {"14567:14567"}
      ["ts-station-service"] {"12345:12345"}
      ["ts-config-service"] {"15679:15679"}
      ["ts-order-other-service"] {"12032:12032"}
      ["ts-order-service"] {"12031:12031"}
      ["ts-contacts-service"] {"12347:12347"}
      ["ts-route-service"] {"11178:11178"}
      ["ts-verification-code-service"] {"15678:15678"}
      ["ts-user-service"] {"12342:12342"}
      ["ts-auth-service"] {"12340:12340"}
      [Dashboard] {"8080:8080"}
      [RabbitMQ] { "5672:5672" "15672:15672" }
    }
  }
}
