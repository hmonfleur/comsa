/// Compose Specification
///
/// The Compose file is a YAML file defining a multi-containers based application.
///
/// This module was generated from JSON Schema from <file:compose/compose_spec.json>.
///
/// WARN: both properties and at least one of additionalProperties and patternProperties are set. This is
/// ambiguously defined; can either be defined as a `Mapping` or a class.
// PM: ajout modifier open
open module ComposeSpec

import "./constrained_object.pkl" as co

/// Version of the Compose specification used. Tools not implementing required version MUST reject the
/// configuration file.
version: String?

services: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Service>?

networks: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Network>?

volumes: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Volume0>?

secrets: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Secret>?

configs: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Config0>?

/// WARN: both properties and at least one of additionalProperties and patternProperties are set. This is
/// ambiguously defined; can either be defined as a `Mapping` or a class.
// PM: ajout modifier open
open class Service extends co.ConstrainedObject {
  deploy: Deployment?

  build: (String|BuildAlternate1)? = Null(new BuildAlternate1 {}) // PM: ajout = Null

  blkio_config: BlkioConfig?

  cap_add: ListOfStrings?

  cap_drop: ListOfStrings?

  cgroup_parent: String?

  command: (String|Listing<String>)? = Null(new Listing<String> {}) // PM: ajout = Null

  configs: Listing<String|SecretAlternate1>?

  container_name: String?

  cpu_count: Int(isPositive)?

  cpu_percent: Int(isBetween(0, 100))?

  cpu_shares: (Number|String)?

  cpu_quota: (Number|String)?

  cpu_period: (Number|String)?

  cpu_rt_period: (Number|String)?

  cpu_rt_runtime: (Number|String)?

  cpus: (Number|String)?

  cpuset: String?

  credential_spec: CredentialSpec?

  depends_on: (ListOfStrings|Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), DependsOnAlternate1>)? = Null(new Listing {}) // PM: ajout = Null

  device_cgroup_rules: ListOfStrings?

  devices: ListOfStrings?

  dns: StringOrList?

  dns_opt: ListOfStrings?

  dns_search: StringOrList?

  domainname: String?

  entrypoint: (String|Listing<String>)? = Null(new Listing<String> {}) // PM: ajout = Null

  env_file: StringOrList?

  environment: ListOrDict? = Null(new Mapping {}) // PM: ajout = Null

  expose: Listing<String|Number>(isDistinct)? = Null(new Listing<String|Number> {}) // PM: ajout = Null

  `extends`: (String|ExtendsAlternate1)?

  external_links: ListOfStrings?

  extra_hosts: ListOrDict? = Null(new Listing{}) // PM: ajout = Null

  group_add: Listing<String|Number>(isDistinct)?

  healthcheck: Healthcheck?

  hostname: String?

  image: String?

  init: Boolean?

  ipc: String?

  isolation: String?

  labels: ListOrDict? = Null(new Mapping {}) // PM: ajout = Null

  links: ListOfStrings?

  logging: Logging?

  mac_address: String?

  mem_limit: (Number|String)?

  mem_reservation: (String|Int)?

  mem_swappiness: Int?

  memswap_limit: (Number|String)?

  network_mode: String?

  networks: (ListOfStrings|Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), NetworksAlternate1Alternate0|Any>)? = Null(new Listing{}) // PM: ajout = Null

  oom_kill_disable: Boolean?

  oom_score_adj: Int(isBetween(-1000, 1000))?

  pid: String?

  pids_limit: (Number|String)?

  platform: String?

  ports: Listing<Number|String|PortAlternate2>(isDistinct)?

  privileged: Boolean?

  profiles: ListOfStrings?

  pull_policy: ("always"|"never"|"if_not_present"|"build")?

  read_only: Boolean?

  restart: String?

  runtime: String?

  scale: Int?

  security_opt: ListOfStrings?

  shm_size: (Number|String)?

  secrets: Listing<String|SecretAlternate1>?

  sysctls: ListOrDict? = Null(new Mapping {}) // PM: ajout = Null

  stdin_open: Boolean?

  stop_grace_period: String?

  stop_signal: String?

  storage_opt: Dynamic?

  tmpfs: StringOrList? = Null(new Listing {}) // PM: ajout = Null

  tty: Boolean?

  ulimits: Mapping<String(matches(Regex("^[a-z]+$"))), Int|UlimitsAlternate1>?

  user: String?

  userns_mode: String?

  volumes: Listing<String|VolumeAlternate1>(isDistinct)? = Null(new Listing<String|VolumeAlternate1>{}) // PM: ajout = Null

  volumes_from: ListOfStrings?

  working_dir: String?

  // Extension to describe runtime communication.
  `x-connects_to`: ListOfStrings? // synchronous calls
  `x-sends_to`: ListOfStrings? // asynchronous messages

  constraints {
    new {
      description = "neither an image nor a build context specified"
      gravity = "Error"
      constraint = (_, service)
        -> (service.image != null) || (service.build != null)
    }
    new {
      description = "depends on undefined service"
      gravity = "Error"
      constraint = (config, service)
        -> let(service_ids = Ids(config.services))
              Ids(service.depends_on).every((d) -> service_ids.contains(d))
      why = (config, service)
        -> let(service_ids = Ids(config.services))
            let(undefined = Ids(service.depends_on)
                            .filter((s) -> !service_ids.contains(s)))
              description + (if(undefined.length==1) " " else "s ") + undefined.join(", ")
    }
    new {
      description = "no healthcheck configured"
      gravity = "Error"
      constraint = (config, service)
        -> if(service.depends_on is Mapping)
              service.depends_on.toMap().every((sn, d) -> if(d.condition == "service_healthy") config.services.getOrNull(sn).healthcheck != null else true)
            else
              true
      why = (config, service)
        -> let(undefined = service.depends_on.toMap()
                          .filter((sn, d) -> if(d.condition == "service_healthy") config.services.getOrNull(sn).healthcheck == null else false).keys)
             description + " in service" + (if(undefined.length==1) "" else "s") + " " + undefined.join(", ")
    }
    new {
      description = "refers to undefined network"
      gravity = "Error"
      constraint = (config, service)
        -> let(network_ids = Ids(config.networks))
              Ids(service.networks).every((n) -> network_ids.contains(n))
      why = (config, service)
        -> let(network_ids = Ids(config.networks))
            let(undefined = Ids(service.networks)
                            .filter((s) -> !network_ids.contains(s)))
              description + (if(undefined.length==1) " " else "s ") + undefined.join(", ")
    }
    new {
      description = "refers to undefined volume"
      gravity = "Error"
      constraint = (config, service)
        -> let(volume_ids = Ids(config.volumes))
             SourceIds(service.volumes)
              .filter((s) -> !"./$".contains(s[0]))
                .every((s) -> volume_ids.contains(s))
      why = (config, service)
        -> let(volume_ids = Ids(config.volumes))
            let(undefined = SourceIds(service.volumes)
                            .filter((s) -> !"./$".contains(s[0]) && !volume_ids.contains(s)))
              description + (if(undefined.length==1) " " else "s ") + undefined.join(", ")
    }
    new {
      description = "refers to undefined config"
      gravity = "Error"
      constraint = (config, service)
        -> let(config_ids = Ids(config.configs))
              SourceIds(service.configs).every((c) -> config_ids.contains(c))
      why = (config, service)
        -> let(config_ids = Ids(config.configs))
            let(undefined = SourceIds(service.configs)
                            .filter((s) -> !config_ids.contains(s)))
             description + (if(undefined.length==1) " " else "s ") + undefined.join(", ")
    }
    new {
      description = "refers to undefined secret"
      gravity = "Error"
      constraint = (config, service)
        -> let(secret_ids = Ids(config.secrets))
              SourceIds(service.secrets).every((s) -> secret_ids.contains(s))
      why = (config, service)
         -> let(secret_ids = Ids(config.secrets))
             let(undefined = SourceIds(service.secrets)
                             .filter((s) -> !secret_ids.contains(s)))
              description + (if(undefined.length==1) " " else "s ") + undefined.join(", ")
    }
    new {
      description = "`scale` is deprecated. Use the `deploy.replicas` element"
      gravity = "Warning"
      constraint = (_, service)
        -> (service.scale == null)
    }
    new {
      description = "can't use both 'scale' (deprecated) and 'deploy.replicas'"
      gravity = "Error"
      constraint = (_, service)
        -> (service.scale == null) || (service.deploy?.replicas == null)
    }
  }
}

const function Ids(o: (Listing<String>|Mapping<String, Any>)?): Set<String>
  = if(o == null)
      Set()
    else if(o is Listing)
      o.toSet()
    else if(o is Mapping)
      o.keys
    else
      null // Should never happen!

const function SourceIds(o: Listing<String|SecretAlternate1|VolumeAlternate1>?): Set<String>
  = if(o == null)
      Set()
    else if(o is Listing<String>)
      o.toSet().map((s) -> s.split(":")[0])
    else if(o is Listing<SecretAlternate1|VolumeAlternate1>)
      o.toList().map((co) -> co.source).toSet()
    else
      null // Should never happen!

