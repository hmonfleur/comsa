open module microservices.comsa
extends "./compose.pkl"
import "./constrained_object.pkl" as co
import "pkl:reflect"

/// Main file property for COMSA described application
concerns: Mapping<String, Concern|MultiConcern>? = Null(new Mapping<String, Concern|MultiConcern> { default = (_) -> new Concern{} })

//
// Concerns
//

/// [String] matching an appropriate [Regex] for setting an identifier.
typealias Id = String(matches(Regex("^[a-zA-Z0-9._-]+$")))

/// Constant used to refer to all services mentionned in the description. Used in application descriptions in the form `module.ALL`
hidden const ALL: Set<Id> = Set("THIS_IS_ALL")
/// Constant used to refer to a service identifier. Can be used in [Mapping], [Listings], [function]... Used in application descriptions in the form `module.SID`.
hidden const SID: String = "{SID}"

/// Base class for concerns.
open class Concern extends co.ConstrainedObject {
  /// Mapping between a set of service identifiers (optionnally  a single identifier)
  /// and a compose [Service](../ComposeSpec/Service.html) acting as set of property 
  /// for defining associated microservices.
  services: Mapping<Id|Collection<Id>, Service>?
  /// Mapping between a set of network identifiers (optionnally  a single identifier)
  /// and a compose [Network](../ComposeSpec/Network.html) acting as set of property 
  /// for defining associated networks.
  networks: Mapping<Id|Collection<Id>, Network>?
  /// Mapping between a set of volume identifiers (optionnally  a single identifier)
  /// and a compose [Volume0](../ComposeSpec/Volume0.html) acting as set of property 
  /// for defining associated volumes.
  volumes: Mapping<Id|Collection<Id>, Volume0>?
  /// Mapping between a set of secret identifiers (optionnally  a single identifier)
  /// and a compose [Secret](../ComposeSpec/Secret.html) acting as set of property 
  /// for defining associated secrets.
  secrets: Mapping<Id|Collection<Id>, Secret>?
  /// Mapping between a set of config identifiers (optionnally  a single identifier)
  /// and a compose [Config](../ComposeSpec/Config.html) acting as set of property 
  /// for defining associated configs.
  configs: Mapping<Id|Collection<Id>, Config>?
  hidden const ALL_SERVICES = module.ALL
}

/// Class to factorize multiple [Concern] defined in the same manner.
open class MultiConcern{
  hidden concern: Class
  attributes: Listing<String>
  values: Listing<Listing | Dynamic | List<Id|Set<Id>> | Id | Set<Id> > | List<List<Id|Set<Id>>> | Set<List<Id|Set<Id>>>  = new Listing{}
  main_service: Service = new Service{}
  service: Service = new Service{}


  @Unlisted
  function values_fitting_attributes(): List =
    let (retval =
      if (values is Listing<Listing | Dynamic>)  values.toList().map( (e) -> e.toList())
      else if (values is Listing<Id|Set<Id>>) list_to_list_of_nlist(values.toList(), attributes.length)
      else  values.toList())
      retval

  @Unlisted
  function compute_concerns(): Mapping<String, Concern> =
    let (list_of_concerns_as_map = this.values_fitting_attributes().map( (e) -> two_lists_to_map(attributes.toList(), e)))
      let (map_of_concerns_as_map = trace(list_of_concerns_as_map.toMap((
        (e) -> "[" + list_of_concerns_as_map.indexOf(e).toString() + "]" + concern.simpleName + "_" +  e.toString()),
        (e) -> e
      )))

        let (map_of_concerns = map_of_concerns_as_map.mapValues((k,v) -> v.toTyped(concern)) +
          map_of_concerns_as_map.filter( (k,v) -> v.containsKey("sids")).map( (k,v) -> Pair(k + "client_service_properties",
            Map("services", Map(v["sids"], outer.service).toMapping()).toTyped(Concern)
          )) +
          map_of_concerns_as_map.filter( (k,v) -> v.containsKey("msid")).map( (k,v) -> Pair(k + "main_service_properties",
            Map("services", Map(v["msid"], outer.main_service).toMapping()).toTyped(Concern)
          )))
          map_of_concerns.toMapping()
}


@Unlisted
open class MultiServiceCentricConcern extends MultiConcern{
  attributes {"msid" "sids"}
}

@Unlisted
open class MultiServiceRegistryPattern extends MultiServiceCentricConcern{
  attributes = new Listing{"msid" "sids"}
  concern = module.ServiceRegistryPattern
}

/// [MultiConcern] class used to define multiple [DatabasePerServicePattern]
/// concerns in a simple place.
open class MultiDatabasePerServicePattern extends MultiServiceCentricConcern{
  attributes = new Listing{"msid" "sid"}
  concern = module.DatabasePerServicePattern
}

@Unlisted
const function two_lists_to_map(l1: List, l2: List): Map =
  if (l1.isEmpty || l2.isEmpty)   Map()
  else Map(l1.first, l2.first) + two_lists_to_map(l1.rest, l2.rest)

@Unlisted
const function list_to_list_of_nlist(l: List, n: Int): List<List> =
  if (l.isEmpty) l
  else List(l.take(n)) + list_to_list_of_nlist(l.drop(n), n)

@Unlisted
function computeConcerns(ccrns: Mapping<String, Concern|MultiConcern>): Mapping<String,Concern> =
  let (ccrn_map = ccrns.toMap())
    let (aggr_ccrn_map = ccrn_map.filter((k,v) -> (v is MultiConcern)))
      let (original_ccrn_map = ccrn_map.filter((k,v) -> (v is Concern)))
        let ( ret_ccrns = original_ccrn_map + computeConcernsFromMultitConcerns(aggr_ccrn_map))
          if (aggr_ccrn_map.isEmpty) ret_ccrns.toMapping()
          else trace(ret_ccrns.toMapping())

@Unlisted
function computeConcernsFromMultitConcerns(acs: Map<String, MultiConcern> | Dynamic): Map<String, Concern> =
  multiConcernsToConcerns(acs.values)

@Unlisted
function multiConcernsToConcerns(acs: List<MultiConcern> | Dynamic | List): Map<String, Concern> =
  if (acs.isEmpty) Map()
  else acs.first.compute_concerns().toMap() + multiConcernsToConcerns(acs.rest)

@Unlisted
abstract class PropertyCentricConcern extends Concern {
  sids: Set<Id>?
}

@Unlisted
abstract class TemplatedPropertyCentricConcern extends PropertyCentricConcern {
  hidden property_name: String
  hidden property_value: Any
  services {
    when (sids == ALL_SERVICES) {
      [sids] = Map(property_name, property_value).toTyped(module.Service)
    }
    when (sids != ALL_SERVICES) {
      for (sid in sids ?? Set()) {
        [sid] =
        if (property_value is Function)
          Map(property_name, property_value.apply(sid)).toTyped(module.Service)
        else
          Map(property_name, property_value).toTyped(module.Service)
      }
    }
  }
}


