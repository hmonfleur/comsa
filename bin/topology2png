#!/usr/bin/env python3
import pprint
import sys
import yaml
import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch
from matplotlib.offsetbox import AnnotationBbox, TextArea, VPacker
import networkx as nx
from numpy import linspace
import matplotlib.patches as mpatches

SYMETRICAL_EDGE_CURVE = 0.1

APIGATEWAY_POSITION = -0.95
REGISTRY_POSITION = 0
DATABASEPERSERVICE_POSITION = 0.95
SHAREDDATABASE_POSITION = 0.85
NOPATTERN_POSITION =  0.5


APIGATEWAY_COLOR = "green"
REGISTRY_COLOR = "red"
DATABASEPERSERVICE_COLOR = "blue"
SHAREDDATABASE_COLOR = "purple"
TRACING_COLOR = "orange"
METRICS_COLOR = "pink"
MESSAGING_COLOR = "magenta"
LOG_COLOR = "brown"
CQRS_COLOR = "navy"
PROXY_COLOR = "lime"
CONFIGURATION_COLOR = "yellow"
SHAREDSERVICE_COLOR = "gold"
SERVICECENTRIC_COLOR = "teal"
AGGREGATOR_COLOR = "teal"
ACCESSTOKEN_COLOR = "navy"
TRANSACTIONAL_COLOR = "cyan"
CIRCUIT_COLOR = "royalblue"

def get_positions_for_pattern(pattern,service_list):
    values = []
    if pattern == "ApiGatewayPattern":
        values = [ (APIGATEWAY_POSITION, v) for v in linspace(0.20, 0.80, len(service_list))]
    elif pattern == "DatabasePerServicePattern":
        values = [ (DATABASEPERSERVICE_POSITION, v) for v in linspace(0.15, 0.85, len(service_list))]
    elif pattern == "SharedDatabasePattern":
        values = [ (SHAREDDATABASE_POSITION, v) for v in linspace(0.25, 0.75, len(service_list))]
#    elif pattern == "ServiceRegistryPattern":
#        values = [ (REGISTRY_POSITION, v) for v in linspace(0.3, 0.7, len(service_list))]
    elif pattern == "Isolated":
        values = [ (v,NOPATTERN_POSITION) for v in linspace(0.25, 0.75, len(service_list))]
    tmp = {service_list[i]:values[i] for i in range(len(values))}
    return tmp

def get_pattern_color(pattern):
    if pattern == "ApiGatewayPattern":
        return APIGATEWAY_COLOR
    elif pattern == "DatabasePerServicePattern":
        return DATABASEPERSERVICE_COLOR
    elif pattern == "SharedDatabasePattern":
        return SHAREDDATABASE_COLOR
    elif pattern == "ServiceRegistryPattern":
        return REGISTRY_COLOR
    elif pattern == "ApplicationMetricsPattern":
        return METRICS_COLOR
    elif pattern == "DistributedTracingPattern":
        return TRACING_COLOR
    elif pattern == "MessagingPattern":
        return MESSAGING_COLOR
    elif pattern == "LogAggregationPattern":
        return LOG_COLOR
    elif pattern == "CQRS_Pattern":
        return CQRS_COLOR
    elif pattern == "ProxyServerPattern":
        return PROXY_COLOR
    elif pattern == "ExternalizedConfigurationPattern":
        return CONFIGURATION_COLOR
    elif pattern == "SharedService":
        return SHAREDSERVICE_COLOR
    elif pattern == "ServiceCentricConcern":
        return SERVICECENTRIC_COLOR
    elif pattern == "Aggregator":
        return AGGREGATOR_COLOR
    elif pattern == "AccessTokenPattern":
        return ACCESSTOKEN_COLOR
    elif pattern == "TransactionalOutboxPattern":
        return TRANSACTIONAL_COLOR
    elif pattern == "CircuitBreakerPattern":
        return TRANSACTIONAL_COLOR
    else:
        return (0,0,0)


def get_msid_by_pattern(graphs):
    msid_by_pattern = {}
    for g in graphs["graphs"].values():
        if g["type"] not in msid_by_pattern:
            msid_by_pattern[g["type"]] = []
        msid_by_pattern[g["type"]].append(g["msid"])
    return msid_by_pattern

def init_graph(topology):
    if "PublicPortsConcern" in topology.keys():
        public_ports = topology["PublicPortsConcern"]
        del topology["PublicPortsConcern"]
    else:
        public_ports = {}
    if "AllServices" in topology.keys():
        all_services = topology["AllServices"]
        del topology["AllServices"]
    else:
        all_services = set()
    graphs = {"edges_to_draw":{}, "isolated_nodes":[], "all_services": all_services, "public_ports" : public_ports, "nodes_positions":{}, "node_edges":{}, "node_colors":{}, "graphs":{}}
    # Compute nodes
    for k,v in topology.items():
        main_service = v["msid"]
        related_services = v["sids"]
        graph_type, graph_name = k.split("&&&")
        graphs["graphs"][graph_name] = {
                "type" : graph_type,
                "color": get_pattern_color(graph_type),
                "msid": main_service,
                "sids": related_services,
                "edges": [(main_service, s) for s in related_services]
        }
        for (x,y) in graphs["graphs"][graph_name]["edges"]:
            graphs["edges_to_draw"][(x,y)] = {
                    "curve":0,
                    "color":graphs["graphs"][graph_name]["color"]
                    }
            if (y,x) in graphs["edges_to_draw"].keys():
                graphs["edges_to_draw"][(x,y)]["curve"] = SYMETRICAL_EDGE_CURVE
        for s in set(related_services):
            if s not in graphs["node_colors"]:
                graphs["node_colors"][s] = (0,0,0)
            if s not in graphs["node_edges"]:
                graphs["node_edges"][s] = []
            graphs["node_edges"][s].append(main_service)
        if main_service not in graphs["node_colors"]:
            graphs["node_colors"][main_service] = (0,0,0)
        if main_service not in graphs["node_edges"]:
            graphs["node_edges"][main_service] = []
        graphs["node_edges"][main_service].extend(related_services)
        graphs["node_colors"][main_service] = graphs["graphs"][graph_name]["color"]
        #G.add_edges_from(graphs["graphs"][graph_name]["edges"])
    # Treat services not in any pattern
    for s in graphs["all_services"]:
        if s not in graphs["node_colors"].keys():
            graphs["node_colors"][s] = "black"
            graphs["isolated_nodes"].append(s)
    for g in graphs["graphs"].values():
        if g["msid"] not in [n for pair in graphs["edges_to_draw"].keys() for n in pair]:
            graphs["isolated_nodes"].append(g["msid"])
        
    # Set positions
    msid_by_pattern = get_msid_by_pattern(graphs)
    # wave sort
    for k,v in msid_by_pattern.items():
        v.sort()
        if k != "DatabasePerServicePattern":
            v.sort(key=lambda x: len(graphs["node_edges"][x]))
            tmp_left = [v[i] for i in range(len(v)) if i%2==0]
            tmp_right = [v[i] for i in range(len(v)) if i%2==1]
            tmp_right.reverse()
            v = tmp_left + tmp_right
        # sort databases appropriately
        else:
            db_list = []
            service_set = set()
            for k2,v2 in graphs["graphs"].items():
                if v2["type"] == "DatabasePerServicePattern":
                    db_list.append(v2["msid"])
                    service_set.add(list(v2["sids"])[0])
            v = sort_dedicated_databases(list(service_set), db_list)
        p = get_positions_for_pattern(k,v)
        graphs["nodes_positions"].update(p)


    # specific positions for Business services
    for k,v in graphs["graphs"].items():
        if v["type"] == "DatabasePerServicePattern":
            client = v["sids"][0]
            cpos = (graphs["nodes_positions"][v["msid"]][0] - 0.4, graphs["nodes_positions"][v["msid"]][1])
            graphs["nodes_positions"][client] = cpos
    #specific position for node not included in any pattern:
    #graphs["nodes_positions"].update(get_positions_for_pattern("Isolated", graphs["isolated_nodes"]))
    return graphs

def sort_dedicated_databases(service_list, db_list):
    tmp = {s:sorted([ y for y in db_list if s.replace("-","").replace("_","").lower() in y.replace("-","").replace("_","").lower()]) for s in service_list}
    ret = []
    for s in sorted(tmp.keys()):
        ret.extend(tmp[s])
    out = sorted([ x for x in db_list if x not in ret])
    ret.extend(out)
    return ret




input_filename = sys.argv[1]
with open(input_filename, "rt") as stream:
    data = yaml.safe_load(stream)

graphs = init_graph(data["topology"])

G = nx.Graph()

for n in graphs["node_colors"].keys():
    if n not in G:
        G.add_node(n)



for g in graphs["graphs"].values():
    G.add_edges_from(g["edges"])

ms_nb = len(G)

fsizex = max(ms_nb*2, 40)
fsizey = max(ms_nb*1.5, 30)

fig, ax = plt.subplots(figsize=(fsizex, fsizey))

if graphs["nodes_positions"] != {}:
    pos = nx.spring_layout(G, pos=graphs["nodes_positions"], fixed=list(graphs["nodes_positions"].keys()), seed=32)
else:
    pos = nx.spring_layout(G, seed=32)


pos = {node: (x * 20, y * 30) for node, (x, y) in pos.items()}

#position isolated_nodes
#print(graphs["isolated_nodes"])
maxposx = max( [x for (x,_) in [(a,b) for n, (a,b) in pos.items() if n not in graphs["isolated_nodes"]]])
minposx = min( [x for (x,_) in [(a,b) for n, (a,b) in pos.items() if n not in graphs["isolated_nodes"]]])
maxposy = max( [y for (_,y) in [(a,b) for n, (a,b) in pos.items() if n not in graphs["isolated_nodes"]]])
minposy = min( [y for (_,y) in [(a,b) for n, (a,b) in pos.items() if n not in graphs["isolated_nodes"]]])

#print("maxposx: ",maxposx)
#print("minposx: ",minposx)
#print("maxposy: ",maxposy)
#print("minposy: ",minposy)

yisolated = maxposy + abs(maxposy-minposy)*0.03
xoffset = (abs(maxposx-minposx))*0.1

isolated_pos = [(v, yisolated) for v in linspace(minposx+xoffset, maxposx-xoffset, len(graphs["isolated_nodes"]))]
for i in range(len(isolated_pos)):
    pos[graphs["isolated_nodes"][i]] = isolated_pos[i]
 
pprint.pprint(pos)

G = nx.MultiDiGraph()

ms_nb = len(pos.items())



for k,v in graphs["edges_to_draw"].items():
    nx.draw_networkx_edges(
        G, pos,
        edgelist = [k],
        edge_color = v["color"],
        width=5,
        connectionstyle="arc3,rad={}".format(v["curve"])
    )

font_size = min(max(20,int(300*(1/ms_nb))),50)


for node, (x, y) in pos.items():
    # Service Box
    service_box = TextArea(node, textprops=dict(size=font_size, weight='bold', bbox=dict(boxstyle="square,pad=0.3", fc="white", ec=graphs["node_colors"][node], lw=6)))
    children = [service_box]
    # Optional Open Port Box
    if node in graphs["public_ports"].keys():
        port_box = TextArea(
            "\n".join(graphs["public_ports"][node]),   # whatever you want under the node name
            textprops=dict(
                size=font_size * 0.8,
                weight='normal',
                bbox=dict(
                    boxstyle="square,pad=0.2",
                    fc="lightgrey",ec=graphs["node_colors"][node],
                    lw=2
                )
            )
        )
        children.append(port_box)
    sep = font_size * 0.48

    vbox = VPacker(children=children,
                       align="center", pad=0, sep=sep)

    ab = AnnotationBbox(vbox, (x, y), frameon=False, box_alignment=(0.5,0.5))
    ax.add_artist(ab)

legend_dict = {graphs["graphs"][n]["type"]:graphs["graphs"][n]["color"] for n in graphs["graphs"]}

handles = [mpatches.Patch(color=color, label=label) for label, color in legend_dict.items()]


plt.legend(handles=handles,
    loc="upper center",       
    bbox_to_anchor=(0.5, -0.05),  
    ncol=max(2, int(len(get_msid_by_pattern(graphs))/2)+len(get_msid_by_pattern(graphs))%2),
    fontsize = font_size,
)


ax.set_aspect('equal')
ax.axis('off')

output_filename = sys.argv[2]
plt.savefig(output_filename, format="png")
print(output_filename, "saved")
