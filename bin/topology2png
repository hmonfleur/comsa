#!/usr/bin/env python3
import sys
import yaml
import matplotlib.pyplot as plt
import networkx as nx


def fix_positions(graphs):
    pos = {}
    for g in graphs["graphs"].values():
        msid = g["msid"]
        t = g["type"]
        if t == "ApiGatewayPattern":
            pos[msid] = (-1,0)
        elif t == "ServiceRegistryPattern":
            pos[msid] = (0,0)
    return pos

input_filename = sys.argv[1]
with open(input_filename, "rt") as stream:
    data = yaml.safe_load(stream)

G = nx.Graph()

color_list = list(plt.cm.tab10.colors)

graphs = {"node_colors":{}, "graphs":{}}
# Compute nodes
for k,v in data["topology"].items():
    main_service = v["msid"]
    related_services = v["sids"]
    graph_type, graph_name = k.split("&&&")
    graphs["graphs"][graph_name] = {
            "type" : graph_type,
            "color": color_list.pop(),
            "msid": main_service,
            "edges": [(main_service, s) for s in related_services]
    }
    for s in set(related_services).union(set([main_service])):
        if s not in graphs["node_colors"]:
            graphs["node_colors"][s] = (0,0,0)
    graphs["node_colors"][main_service] = graphs["graphs"][graph_name]["color"]
    G.add_edges_from(graphs["graphs"][graph_name]["edges"])

fpos=fix_positions(graphs)
pos = nx.spring_layout(G, pos=fpos, fixed=list(fpos.keys()), seed=42)

for g in graphs["graphs"].values():
    nx.draw_networkx_edges(
        G, pos,
        edgelist = g["edges"],
        edge_color = g["color"],
        width=2
    )
node_list = list(graphs["node_colors"].keys())
nx.draw_networkx_nodes(
    G, pos,
    nodelist=node_list,
    node_color=[graphs["node_colors"][n] for n in node_list],
    node_size=300
)


plt.axis("off")
plt.show()


#output_filename = sys.argv[2]
#plt.savefig(output_filename, format="png")
#print(output_filename, "saved")
