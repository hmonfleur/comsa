#!/bin/sh
#PM: export PATH="$(pwd)/bin:$PATH"
exec pkl-eval - <<EOF
import "$(pkl-uri $1)" as template
tmp_concerns= (template.computeConcerns(template.concerns))
output {
  renderer = new YamlRenderer {}
  value = new {
    version = template.version
    services = template.computeServicesModified(template.services, tmp_concerns)
    networks = template.computeNetworks(tmp_concerns)
    volumes = template.computeVolumes(template.volumes, tmp_concerns)
    secrets = template.secrets
    configs = template.configs
  }
}
EOF
}
